#!/bin/sh /etc/rc.common
# BaiduPCS-Rust procd 服务脚本（/etc/init.d/baidupcs-rust）
#
# 用法：
#   /etc/init.d/baidupcs-rust enable|disable   开机自启开关
#   /etc/init.d/baidupcs-rust start|stop|restart|reload
#   /etc/init.d/baidupcs-rust status           服务状态 + 后端 /health 健康检查
#   /etc/init.d/baidupcs-rust regenerate       以 UCI 为准重建 app.toml（会覆盖
#                                              Web 界面已保存的设置，慎用）

USE_PROCD=1
START=99
STOP=10

NAME=baidupcs-rust
BIN=/usr/bin/baidu-netdisk-rust

EXTRA_COMMANDS="status regenerate"
EXTRA_HELP="	status	Show procd service state and backend /health status
	regenerate	Regenerate <workdir>/config/app.toml from /etc/config/baidupcs-rust"

# ---------------------------------------------------------------------------
# 工具函数
# ---------------------------------------------------------------------------

# 列表项拼接为 TOML 数组内容：["a", "b"]
_LIST_ITEMS=""
_append_path_item() {
	_LIST_ITEMS="${_LIST_ITEMS:+$_LIST_ITEMS, }\"$1\""
}

# generate_config <app.toml 路径> [force]
generate_config() {
	local file="$1" mode="$2"
	if [ "$mode" != "force" ] && [ -f "$file" ]; then
		return 0
	fi

	local workdir host port download_dir chunks chunk_mb retries fs_default
	config_get workdir main workdir /opt/baidupcs-rust
	config_get host main host 0.0.0.0
	config_get port main port 18888
	config_get download_dir main download_dir "$workdir/downloads"
	config_get chunks main concurrent_chunks 8
	config_get chunk_mb main chunk_size_mb 10
	config_get retries main max_retries 3
	config_get fs_default main fs_default_path "$download_dir"

	_LIST_ITEMS=""
	config_list_foreach main fs_allowed_paths _append_path_item
	case "$_LIST_ITEMS" in
		*"$download_dir"*) ;;
		*) _LIST_ITEMS="$_LIST_ITEMS${_LIST_ITEMS:+, }\"$download_dir\"" ;;
	esac

	{
		echo "# 由 /etc/init.d/baidupcs-rust 依据 /etc/config/baidupcs-rust 生成"
		echo "# 注意：Web 管理界面会直接写回本文件；本文件存在时启动脚本不再覆盖。"
		echo ""
		echo "[server]"
		echo "host = \"$host\""
		echo "port = $port"
		echo "cors_origins = [\"*\"]"
		echo ""
		echo "[download]"
		echo "download_dir = \"$download_dir\""
		echo "concurrent_chunks = $chunks"
		echo "chunk_size_mb = $chunk_mb"
		echo "max_retries = $retries"
		echo ""
		echo "[filesystem]"
		echo "allowed_paths = [$_LIST_ITEMS]"
		echo "default_path = \"$fs_default\""
		echo "show_hidden = false"
		echo "follow_symlinks = false"
	} > "$file"
}

# 向 WAN 开放 Web 端口（仅当 expose_wan=1；默认关闭）
add_firewall_rule() {
	local port="$1"
	[ "$(uci -q get firewall.baidupcs_wan_web)" != "" ] && return 0
	uci -q set firewall.baidupcs_wan_web=rule
	uci -q set firewall.baidupcs_wan_web.name='baidupcs-rust-web'
	uci -q set firewall.baidupcs_wan_web.src='wan'
	uci -q set firewall.baidupcs_wan_web.proto='tcp'
	uci -q set firewall.baidupcs_wan_web.dest_port="$port"
	uci -q set firewall.baidupcs_wan_web.target='ACCEPT'
	uci -q commit firewall
	/etc/init.d/firewall reload 2>/dev/null
}

# ---------------------------------------------------------------------------
# procd 服务
# ---------------------------------------------------------------------------

start_service() {
	local enabled workdir log_level port
	config_load "$NAME"

	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$BIN" ] || {
		logger -t "$NAME" "binary $BIN not found"
		return 1
	}

	config_get workdir main workdir /opt/baidupcs-rust
	config_get log_level main log_level info
	config_get port main port 18888

	mkdir -p "$workdir/config" "$workdir/wal" "$workdir/logs" \
		"$workdir/downloads"

	generate_config "$workdir/config/app.toml"

	local expose_wan
	config_get_bool expose_wan main expose_wan 0
	[ "$expose_wan" = 1 ] && add_firewall_rule "$port"

	procd_open_instance "$NAME"
	procd_set_param command "$BIN"
	procd_set_param cwd "$workdir"
	procd_set_param env RUST_LOG="$log_level" RUST_BACKTRACE=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

stop_service() {
	logger -t "$NAME" "service stopped"
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

# ---------------------------------------------------------------------------
# 附加命令
# ---------------------------------------------------------------------------

status() {
	config_load "$NAME"
	local port
	config_get port main port 18888

	if ubus call service list 2>/dev/null | grep -q "\"$NAME\""; then
		echo "procd: service \"$NAME\" is registered (running)"
	else
		echo "procd: service \"$NAME\" is NOT running"
	fi

	if wget -q -O- "http://127.0.0.1:$port/health" 2>/dev/null; then
		echo ""
		echo "backend health: OK (127.0.0.1:$port/health)"
	else
		echo "backend health: unreachable on port $port"
	fi
}

regenerate() {
	config_load "$NAME"
	local workdir
	config_get workdir main workdir /opt/baidupcs-rust
	mkdir -p "$workdir/config"
	generate_config "$workdir/config/app.toml" force
	echo "Regenerated $workdir/config/app.toml (UCI overrides Web UI settings)."
	echo "Run '/etc/init.d/baidupcs-rust restart' to apply."
}
